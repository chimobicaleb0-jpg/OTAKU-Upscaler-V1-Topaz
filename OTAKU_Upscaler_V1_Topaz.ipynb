      "source": [
        "# 🔥 OTAKU UPSCALER V1 — TOPAZ INSPIRED\n",
        "\n",
        "AI image upscaling for anime and movies.\n",
        "\n",
        "**V1:** 2× / 4× image upscaling with Real-ESRGAN, VRAM-aware tiling, preview, result information and download.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# GPU CHECK\n",
        "import torch\n",
        "\n",
        "print(\"🔥 OTAKU GPU CHECK\")\n",
        "print(\"==================\")\n",
        "print(\"PyTorch:\", torch.__version__)\n",
        "print(\"CUDA:\", torch.cuda.is_available())\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    print(\"GPU:\", torch.cuda.get_device_name(0))\n",
        "    props = torch.cuda.get_device_properties(0)\n",
        "    print(\"VRAM:\", round(props.total_memory / 1024**3, 2), \"GB\")\n",
        "else:\n",
        "    print(\"❌ CUDA GPU not detected.\")\n",
        "    print(\"Select Runtime → Change runtime type → T4 GPU.\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# AI ENVIRONMENT\n",
        "!apt-get -qq update\n",
        "!apt-get -qq install -y python3.11 python3.11-venv\n",
        "\n",
        "# Recreate environment with access to Colab's system packages.\n",
        "!rm -rf /content/venv311\n",
        "!python3.11 -m venv --system-site-packages /content/venv311\n",
        "!/content/venv311/bin/python -m ensurepip --upgrade\n",
        "!/content/venv311/bin/python -m pip install --upgrade pip\n",
        "!/content/venv311/bin/pip install -q basicsr facexlib gfpgan\n",
        "\n",
        "print(\"✅ OTAKU Python 3.11 environment ready\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# BASICSR COMPATIBILITY\n",
        "BASICSR_FILE = \"/content/venv311/lib/python3.11/site-packages/basicsr/data/degradations.py\"\n",
        "\n",
        "!sed -i 's/from torchvision.transforms.functional_tensor import rgb_to_grayscale/from torchvision.transforms.functional import rgb_to_grayscale/' /content/venv311/lib/python3.11/site-packages/basicsr/data/degradations.py\n",
        "\n",
        "print(\"✅ BasicSR compatibility patch applied\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# REAL-ESRGAN ENGINE + MODEL\n",
        "%cd /content\n",
        "\n",
        "!rm -rf /content/realesrgan\n",
        "!git clone -q https://github.com/xinntao/Real-ESRGAN.git /content/realesrgan\n",
        "\n",
        "%%writefile /content/realesrgan/realesrgan/version.py\n",
        "__version__ = \"0.3.0\"\n",
        "\n",
        "!mkdir -p /content/realesrgan/weights\n",
        "!wget -q --show-progress https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth -O /content/realesrgan/weights/RealESRGAN_x4plus.pth\n",
        "\n",
        "print(\"✅ Real-ESRGAN engine ready\")\n",
        "print(\"✅ RealESRGAN_x4plus model ready\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# VERIFY VENV GPU + ENGINE\n",
        "!/content/venv311/bin/python -c \"import torch; print('PyTorch:', torch.__version__); print('CUDA:', torch.cuda.is_available()); print('GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'NONE')\"\n",
        "\n",
        "!/content/venv311/bin/python -c \"import basicsr; print('BasicSR: OK')\"\n",
        "\n",
        "print(\"🔥 OTAKU engine verification complete\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# OTAKU TOPAZ REFERENCE PROFILE\n",
        "# Reference values from the supplied Topaz settings.\n",
        "# These are NOT falsely exposed as Real-ESRGAN controls.\n",
        "\n",
        "OTAKU_TOPAZ_REFERENCE = {\n",
        "    \"video_quality\": \"High\",\n",
        "    \"video_type\": \"Progressive\",\n",
        "    \"video_artifact_type\": \"High Compression\",\n",
        "    \"ai_model_reference\": \"Proteus – Fine Tune\",\n",
        "    \"before_cc\": {\n",
        "        \"revert_compression\": 74,\n",
        "        \"recover_details\": 88,\n",
        "        \"sharpen\": 40,\n",
        "        \"reduce_noise\": 59,\n",
        "        \"dehalo\": 13,\n",
        "        \"antialias_deblur\": -22\n",
        "    },\n",
        "    \"after_cc\": {\n",
        "        \"revert_compression\": 65,\n",
        "        \"recover_details\": 86,\n",
        "        \"sharpen\": 10,\n",
        "        \"reduce_noise\": 62,\n",
        "        \"dehalo\": 15,\n",
        "        \"antialias_deblur\": -49\n",
        "    },\n",
        "    \"output_size\": \"200%\",\n",
        "    \"video_format\": \"MOV – ProRes 422 HQ\"\n",
        "}\n",
        "\n",
        "print(\"🔥 OTAKU Topaz reference profile loaded\")\n",
        "print(\"ℹ️ V1 uses Real-ESRGAN for actual processing.\")\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# 🔥 OTAKU UPSCALER V1 — NEW UI + ENGINE\n",
        "\n",
        "import os\n",
        "import subprocess\n",
        "import uuid\n",
        "from pathlib import Path\n",
        "\n",
        "import gradio as gr\n",
        "from PIL import Image\n",
        "\n",
        "REAL_ESRGAN = Path(\"/content/realesrgan\")\n",
        "VENV_PYTHON = \"/content/venv311/bin/python\"\n",
        "MODEL = \"RealESRGAN_x4plus\"\n        "\n",
        "WORK_DIR = Path(\"/content/otaku_v1\")\n",
        "WORK_DIR.mkdir(parents=True, exist_ok=True)\n        "\n",
        "\n",
        "def get_gpu_info():\n",
        "    if not torch.cuda.is_available():\n",
        "        return \"No CUDA GPU\", 0\n",
        "\n",
        "    name = torch.cuda.get_device_name(0)\n",
        "    vram = torch.cuda.get_device_properties(0).total_memory / 1024**3\n",
        "    return name, vram\n",
        "\n",
        "\n",
        "def choose_tile(vram_gb):\n",
        "    # Conservative automatic tiling for Colab GPUs.\n",
        "    if vram_gb >= 20:\n",
        "        return 512\n",
        "    if vram_gb >= 12:\n",
        "        return 384\n",
        "    if vram_gb >= 8:\n",
        "        return 256\n",
        "    return 128\n",
        "\n",
        "\n",
        "def otaku_upscale(image, scale, mode):\n",
        "    if image is None:\n",
        "        raise gr.Error(\"📥 Upload an image first.\")\n",
        "\n",
        "    if not torch.cuda.is_available():\n",
        "        raise gr.Error(\"❌ CUDA GPU not detected. Select a T4 GPU in Colab Runtime settings.\")\n",
        "\n",
        "    gpu_name, vram_gb = get_gpu_info()\n",
        "    tile = choose_tile(vram_gb)\n",
        "    scale_value = int(scale.replace(\"×\", \"\"))\n",
        "\n",
        "    job_id = uuid.uuid4().hex[:10]\n",
        "    job_dir = WORK_DIR / job_id\n",
        "    input_dir = job_dir / \"input\"\n",
        "    output_dir = job_dir / \"output\"\n",
        "\n",
        "    input_dir.mkdir(parents=True, exist_ok=True)\n",
        "    output_dir.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    input_path = input_dir / \"input.png\"\n",
        "\n",
        "    image = image.convert(\"RGB\")\n",
        "    image.save(input_path)\n",
        "\n",
        "    original = Image.open(input_path)\n",
        "    original_size = original.size\n",
        "\n",
        "    print(\"\\n🔥 OTAKU AI ENGINE\")\n",
        "    print(\"============================\")\n",
        "    print(f\"🎨 Mode: {mode}\")\n",
        "    print(f\"⚡ Scale: {scale_value}×\")\n",
        "    print(f\"🧠 Model: {MODEL}\")\n",
        "    print(f\"🎮 GPU: {gpu_name}\")\n",
        "    print(f\"💾 VRAM: {vram_gb:.2f} GB\")\n",
        "    print(f\"🧩 Auto Tile: {tile}\")\n",
        "    print(f\"📐 Input: {original_size[0]} × {original_size[1]}\")\n",
        "    print(\"🚀 Processing...\\n\")\n",
        "\n",
        "    command = [\n",
        "        VENV_PYTHON,\n",
        "        \"inference_realesrgan.py\",\n",
        "        \"-n\", MODEL,\n",
        "        \"-i\", str(input_path),\n",
        "        \"-o\", str(output_dir),\n",
        "        \"--outscale\", str(scale_value),\n",
        "        \"--tile\", str(tile),\n",
        "        \"--tile_pad\", \"10\"\n",
        "    ]\n",
        "\n",
        "    process = subprocess.run(\n",
        "        command,\n",
        "        cwd=str(REAL_ESRGAN),\n",
        "        text=True,\n",
        "        capture_output=True\n",
        "    )\n",
        "\n",
        "    if process.stdout:\n",
        "        print(process.stdout)\n",
        "\n",
        "    if process.returncode != 0:\n",
        "        print(process.stderr)\n",
        "        raise gr.Error(\"❌ OTAKU AI processing failed. Check the Colab output for details.\")\n",
        "\n",
        "    outputs = [p for p in output_dir.iterdir() if p.is_file() and p.name.startswith(\"input_out\")]\n",
        "\n",
        "    if not outputs:\n",
        "        outputs = list(output_dir.glob(\"*_out.*\"))\n",
        "\n",
        "    if not outputs:\n",
        "        raise gr.Error(\"⚠️ Processing finished, but OTAKU could not find the output image.\")\n",
        "\n",
        "    output_path = outputs[0]\n",
        "    result = Image.open(output_path).convert(\"RGB\")\n",
        "    output_size = result.size\n",
        "\n",
        "    info = (\n",
        "        \"🔥 OTAKU UPSCALE COMPLETE\\n\"\n        \"────────────────────────\\n\"\n        f\"🎨 Mode       : {mode}\\n\"\n        f\"⚡ Scale      : {scale_value}×\\n\"\n        f\"🧠 Model      : {MODEL}\\n\"\n        f\"🎮 GPU        : {gpu_name}\\n\"\n        f\"💾 VRAM       : {vram_gb:.2f} GB\\n\"\n        f\"🧩 Auto Tile  : {tile}\\n\"\n        f\"📥 Original   : {original_size[0]} × {original_size[1]}\\n\"\n        f\"📤 Output     : {output_size[0]} × {output_size[1]}\\n\"\n        f\"🆔 Job        : {job_id}\"\n    )\n\n    return result, info, str(output_path)\n\n\nCSS = \"\"\"\nbody {\n    background: #070707 !important;\n}\n\n.gradio-container {\n    max-width: 1250px !important;\n    margin: auto !important;\n    background: #070707 !important;\n}\n\n.otaku-title {\n    text-align: center;\n    padding: 28px 10px 18px 10px;\n}\n\n.otaku-title h1 {\n    font-size: 42px !important;\n    letter-spacing: 4px;\n    margin-bottom: 4px !important;\n}\n\n.otaku-title p {\n    opacity: 0.65;\n    font-size: 14px;\n}\n\n.otaku-card {\n    border-radius: 18px !important;\n    border: 1px solid #242424 !important;\n    background: #101010 !important;\n    padding: 12px !important;\n}\n\n.otaku-button button {\n    min-height: 58px !important;\n    font-size: 17px !important;\n    font-weight: 800 !important;\n    letter-spacing: 2px !important;\n}\n\n.otaku-status textarea {\n    font-family: monospace !important;\n    font-size: 13px !important;\n}\n\"\"\"\n\n\nwith gr.Blocks(\n    title=\"OTAKU UPSCALER V1\",\n    theme=gr.themes.Base(),\n    css=CSS\n) as otaku_app:\n\n    gr.HTML(\n        \"\"\"\n        <div class='otaku-title'>\n            <h1>🔥 OTAKU UPSCALER</h1>\n            <p>V1 • AI IMAGE ENHANCEMENT ENGINE</p>\n            <p>REAL-ESRGAN • VRAM-AWARE TILING • 2× / 4×</p>\n        </div>\n        \"\"\"\n    )\n\n    with gr.Row():\n        with gr.Column(scale=1, elem_classes=\"otaku-card\"):\n            gr.Markdown(\"## 📥 INPUT\")\n\n            input_image = gr.Image(\n                type=\"pil\",\n                label=\"Upload Image\",\n                height=390\n            )\n\n            with gr.Row():\n                scale = gr.Radio(\n                    choices=[\"2×\", \"4×\"],\n                    value=\"2×\",\n                    label=\"⚡ Upscale\"\n                )\n\n                mode = gr.Radio(\n                    choices=[\"Anime\", \"Movie\"],\n                    value=\"Anime\",\n                    label=\"🎨 Content\"\n                )\n\n            upscale_button = gr.Button(\n                \"🔥 UPSCALE\",\n                variant=\"primary\",\n                elem_classes=\"otaku-button\"\n            )\n\n        with gr.Column(scale=1, elem_classes=\"otaku-card\"):\n            gr.Markdown(\"## ✨ RESULT\")\n\n            output_image = gr.Image(\n                type=\"pil\",\n                label=\"OTAKU Result\",\n                height=390\n            )\n\n            output_info = gr.Textbox(\n                label=\"📊 ENGINE INFORMATION\",\n                lines=10,\n                interactive=False,\n                elem_classes=\"otaku-status\"\n            )\n\n            download_file = gr.File(\n                label=\"⬇️ DOWNLOAD RESULT\"\n            )\n\n    gr.Markdown(\"---\")\n\n    with gr.Row():\n        gr.Markdown(\n            \"\"\"\n            ### 🧠 V1 ENGINE\n            **Model:** RealESRGAN_x4plus  \n            **Scale:** 2× / 4×  \n            **Tiling:** Automatic based on detected VRAM  \n            **GPU:** NVIDIA CUDA / Colab T4 compatible\n            \"\"\"\n        )\n\n        gr.Markdown(\n            \"\"\"\n            ### 🚧 OTAKU ROADMAP\n            **V1:** Image Upscale ✅  \n            **V2:** Video Processing  \n            **V3:** FPS Enhancement  \n            **V4:** CC / Detail Controls  \n            **V5:** Full OTAKU Studio\n            \"\"\"\n        )\n\n    upscale_button.click(\n        fn=otaku_upscale,\n        inputs=[input_image, scale, mode],\n        outputs=[output_image, output_info, download_file]\n    )\n\n    gr.Markdown(\n        \"\"\"\n        <center>\n        <small>OTAKU UPSCALER V1 • AI IMAGE ENGINE</small>\n        </center>\n        \"\"\"\n    )\n\n\notaku_app.launch(share=True, debug=True)\n"
      ]
    }
  ],
